# tutorial: Show tap hints at startup and after 3 seconds without input.
# mouse: Show the hand as a mouse cursor for recording.
# disabled: Keep the regular cursor without tap hints.
VITE_HAND_MODE=tutorial

# true: Shuffle the preset truck loads across the six lanes.
# false: Shuffle all truck loads normally.
VITE_EASY_START=false

# true: Show the success screen after the first completed truck for testing.
# false: Show it after all six trucks are complete.
VITE_WIN_AFTER_FIRST_TRUCK=true
