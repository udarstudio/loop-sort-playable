# tutorial: Follow the preset truck order or show random tap hints on the shuffled board.
# mouse: Show the hand as a mouse cursor for recording.
# disabled: Keep the regular cursor without tap hints.
VITE_HAND_MODE=tutorial

# true: Shuffle the preset truck loads across the six lanes.
# false: Shuffle all truck loads normally.
VITE_EASY_START=true

# classic: Use pink, orange, and white bricks with Casual Music Loop 18.
# alternative: Use rose, yellow, and blue bricks with Casual Music Loop 01.
VITE_PLAYABLE_VARIANT=classic
